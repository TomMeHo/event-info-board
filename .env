# Django settings
DJANGO_SECRET_KEY="your-very-secure-secret-key"
DJANGO_DEBUG=True
DJANGO_LOGLEVEL=INFO
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1"
DJANGO_CSRF_TRUSTED_ORIGINS="http://localhost"

# Database
DATABASE_ENGINE=postgresql
DATABASE_NAME=dockerdjango
DATABASE_USERNAME=dbuser
DATABASE_PASSWORD=dbpassword
DATABASE_HOST=db
DATABASE_PORT=5432

# JJCM API
JJCM_BASE=https://jjcm.foehst.net
JJCM_USERNAME=<username>
JJCM_PASSWORD=<password>

# OIDC / PocketID (set DJANGO_OIDC_ENABLED=True to enable)
DJANGO_OIDC_ENABLED=False
DJANGO_OIDC_CLIENT_ID=
DJANGO_OIDC_CLIENT_SECRET=
DJANGO_OIDC_AUTHORIZATION_ENDPOINT=https://your-pocketid.example.com/authorize
DJANGO_OIDC_TOKEN_ENDPOINT=https://your-pocketid.example.com/token
DJANGO_OIDC_USER_ENDPOINT=https://your-pocketid.example.com/userinfo
DJANGO_OIDC_JWKS_ENDPOINT=https://your-pocketid.example.com/.well-known/jwks.json
DJANGO_OIDC_SIGN_ALGO=RS256

# Access gate
ACCESS_PASSWORD=change-me
ACCESS_TOKEN=change-me-to-a-random-hex-string

# Footer
FOOTER_LINK_URL=https://dm2026.tv-hochstetten.de
FOOTER_LINK_LABEL=Deutsche Meisterschaften 2026
FOOTER_IMPRESSUM_URL=https://www.tv-hochstetten.de/impressum

# Board changes content periodically. Default = 20 seconds
BOARD_MAIN_SECONDS=10
BOARD_DETAIL_SECONDS=10